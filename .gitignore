venv/
__pycache__/
*.pyc
.env
.aider*

# Never commit personal/medical/identity context — belongs in Cowork
# Global Instructions or a private location, not this repo.
USER_PROFILE.md
docs/USER_PROFILE.md
PERSONA*.md

# --- Added 2026-07-30, git hygiene pass ---
# Runtime logs, not source
logs/
pipeline_log.txt
# Built binaries (build from source instead)
*.exe
# Go leaves a ~ backup when it cannot replace a RUNNING exe - rebuilding while a
# collector session is live produces one. It is the old binary the running
# process still has mapped, so it is left alone rather than removed.
*.exe~
# Database backup dumps - not source, can be large
*.dump
# Local Claude Code settings - machine-specific paths, not portable
.claude/
# Working/transient drop folder - contents get archived into docs/handoff_archive/ instead
inbox/
# Unvetted scratch material awaiting review - not ready for public repo
_needs_review/
_zip_archive/
# Old flat-naming duplicate data dump (177MB single file, exceeds GitHub's 100MB/file limit
# anyway) - superseded by the reconciled data-layer/ structure
data-layerrawhardpoints/
# Third-party community 3D asset dataset (non-commercial-fan-use licensed, ~4GB) - holding off
# committing/redistributing this via the public repo until explicitly confirmed; see chat log
# 2026-07-30 for the license text and reasoning
sc-ships/

# Generated project snapshot/archive (regenerated by ccpp.py / watcher-go's
# ccpp.go on every scan) - a build artifact, not source
citizen-compass.ccpp

# Scratch holding area for files Claude moved aside instead of deleting
# (device bridge can't unlink files) - safe for the user to delete manually
_to_delete/

# Raw external-source snapshots (2026-07-31 external data landing run).
# Provenance records for these live in data-layer/external-source-manifests/,
# which IS tracked - the record survives even though the raw data doesn't.
data-layer/external-sources/

# ---- testing area, 2026-08-01 ----------------------------------------------
# testing/_layer.html and testing/build.py ARE source and stay tracked.
# Everything below is a build artifact or a large binary and must never be
# committed - testing/_deploy alone is 344 MB of compressed ship models.
testing/index.html
testing/_deploy/
testing/_models/
testing/_tools/

# ---- bundled WebView2 runtime, 2026-08-07 ----------------------------------
# 502 MB of Microsoft browser engine, bundled so the UI cannot fail with a
# missing runtime on a stranger's machine (WO-UI-01 §3). Regenerable from the
# recorded source, so the payload stays out and the PROVENANCE RECORD stays
# tracked - the same separation data-layer/external-sources uses.
# See citizen-collector/WEBVIEW2_RUNTIME_PROVENANCE.md, which IS committed.
citizen-collector/webview2-runtime/

# ---- wrangler local state, 2026-08-06 --------------------------------------
# wrangler writes an account cache containing the Cloudflare account id and the
# account NAME, which is the contact email address. That file has already been
# published once: a failed wrangler run inside testing/_deploy/ left it there
# and the next deploy served it at /.wrangler/cache/wrangler-account.json.
# It has since reappeared at the repo root.
#
# These patterns carry NO leading or embedded slash, so git matches them at ANY
# depth rather than at one known location. That is deliberate. Both sightings so
# far were in places nobody predicted, and anchoring to testing/_deploy/ or to
# the root would only ignore where it landed the last two times.
.wrangler/
wrangler-account.json

# Generated route/pair shards (WO-COLLECT-01 rev 5 §1.5). Same separation the
# external-sources rule uses: the bulk output is regenerable and stays out, the
# provenance record and the small tables stay tracked. Emitting every system
# keyed by drive measures 4.7 GB; keyed by ship, 19.0 GB.
data-layer/derived/**/pairs/
data-layer/derived/**/routes/

# Node test-only dependencies (testing/_src, testing/_tools). Never shipped;
# _deploy/ vendors what actually ships. Added 2026-08-09.
node_modules/

# wrangler local dev secrets - never committed
citizen-collector/.dev.vars

# Per-machine collector state, same reasoning as the consent record: it is
# written by the running program and describes THIS install, so committing it
# would ship one machine's cached destination and send history to everybody.
citizen-collector/collector-destination.json
citizen-collector/collector-last-send.txt
citizen-collector/*.rolledback

# Decoded hull vertices (data-layer/derived/hull-geometry/) - ~380 MB of point
# clouds regenerated on demand by testing/_src/decode_glb_points.js from the
# models already in testing/_deploy. An input to the hardpoint matcher controls
# via CC_GEO_DIR, not source, and it is derived from data that is itself
# gitignored.
data-layer/derived/hull-geometry/

# F3: Playwright's Chromium, pinned INSIDE the repo by PLAYWRIGHT_BROWSERS_PATH
# so the install honours "under checks/" rather than writing to the user's
# AppData. 703 MB of browser is not a source artifact - test-only, never
# shipped, and _deploy/ contains no part of it.
checks/.playwright-browsers/

# Build receipt: how the last build_deploy.py run ENDED, read by
# deploy_testing.ps1 so a failed build cannot be followed by an upload.
# Per-machine state about one run, not project content.
testing/_src/.last_build.json

# Sweep receipt (Q10): which controls passed against WHICH payload, read by
# both deploy scripts so a payload no sweep has vouched for cannot be
# uploaded. Same reasoning as the build receipt above - it is per-machine
# state about one run, and it names a fingerprint of testing/_deploy, which
# is itself gitignored. A committed receipt would describe a payload no clone
# has, which is worse than no receipt: the gate fails closed on a missing one
# and would be fooled by a stale one.
checks/.last_sweep.json
# Its sibling, for the same reason. Q30 split --only and --self-test runs onto
# their own path so a subset can no longer overwrite the real receipt; both are
# machine state and neither belongs in history.
checks/.last_sweep_partial.json
